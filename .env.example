# Copy to .env and adjust. Every setting in docextract/config.py can be set here.

# --- Models (any OpenAI-compatible API) ---
# Local Ollama (default, free, runs on your GPU):
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b        # approach A: text LLM reading OCR output
VLM_MODEL=qwen2.5vl:3b      # approach B: vision-language model reading the image

# OpenAI instead (both approaches can use gpt-4o-mini):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# VLM_MODEL=gpt-4o-mini

# --- OCR / preprocessing ---
# DEVICE=auto
# PDF_DPI=200
# VLM_MAX_SIDE=1280         # lower (e.g. 1024) if the VLM runs out of GPU memory

# --- Validation ---
# DATE_DAYFIRST=true        # false for US-style dates (MM/DD/YYYY)
# REVIEW_CONFIDENCE=0.6
# MAX_RETRIES=1
